<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Tailscale MagicDNS and 100.x addresses commonly use HTTP on a private network. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
