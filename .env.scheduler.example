# Local development only. Production shiva-scheduler receives an explicit,
# least-privilege PM2/Compose environment and never reads Core's .env.
DATABASE_URL=postgresql://shiva:change-me@127.0.0.1:5432/shiva
DATABASE_POOL_MAX=2
DATABASE_SSL=false
SHIVA_TIME_ZONE=Asia/Kolkata
SHIVA_SCHEDULER_CORE_URL=http://127.0.0.1:3000
# Use the same random 32+ character value configured for shiva-api.
SHIVA_SCHEDULER_TOKEN=replace-with-at-least-32-random-characters
SCHEDULER_DATABASE_POOL_MAX=2
SCHEDULER_CORE_TIMEOUT_MS=330000
SCHEDULER_PROCESSING_UNCERTAIN_AFTER_MS=600000
SCHEDULER_JOB_RETRY_LIMIT=5
SCHEDULER_JOB_RETRY_DELAY_SECONDS=5
SCHEDULER_JOB_EXPIRE_SECONDS=600
SCHEDULER_JOB_HEARTBEAT_SECONDS=30
SCHEDULER_JOB_RETENTION_SECONDS=31536000
SCHEDULER_JOB_DELETE_AFTER_SECONDS=2592000
NODE_ENV=development
