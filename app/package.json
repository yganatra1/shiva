{
  "name": "shiva-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend foundation for Shiva, a private personal AI.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "db:migrate:dev": "tsx src/database/migrate.ts",
    "kite:generate-session": "tsx scripts/kite-generate-session.ts",
    "dev": "tsx watch src/server.ts",
    "dev:device-agent": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx watch src/agents/device/device-agent-runner.ts",
    "dev:google-agent": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx watch src/agents/google/google-agent-runner.ts",
    "dev:developer-agent": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx watch src/agents/developer/developer-agent-runner.ts",
    "dev:trading-agent": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx watch src/agents/trading/trading-agent-runner.ts",
    "dev:finance-manager-agent": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx watch src/agents/finance-manager/finance-manager-agent-runner.ts",
    "dev:scheduler": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx watch src/scheduler/scheduler-worker.ts",
    "agent:device": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx src/agents/device/device-agent-runner.ts",
    "agent:google": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx src/agents/google/google-agent-runner.ts",
    "agent:developer": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx src/agents/developer/developer-agent-runner.ts",
    "agent:trading": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx src/agents/trading/trading-agent-runner.ts",
    "agent:finance-manager": "SHIVA_LOAD_AGENT_ENV_FILES=true tsx src/agents/finance-manager/finance-manager-agent-runner.ts",
    "build": "tsc -p tsconfig.json && tsc-esm-fix --tsconfig=tsconfig.json --ext=.js",
    "start": "node dist/server.js",
    "start:device-agent": "node dist/agents/device/device-agent-runner.js",
    "start:google-agent": "node dist/agents/google/google-agent-runner.js",
    "start:developer-agent": "node dist/agents/developer/developer-agent-runner.js",
    "start:trading-agent": "node dist/agents/trading/trading-agent-runner.js",
    "start:finance-manager-agent": "node dist/agents/finance-manager/finance-manager-agent-runner.js",
    "start:scheduler": "node dist/scheduler/scheduler-worker.js",
    "test": "tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "google-auth-library": "^11.0.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.28.0",
    "redis": "^5.12.1",
    "undici": "^8.10.0",
    "ws": "^8.18.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
