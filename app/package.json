{
  "name": "shiva-backend",
  "version": "0.3.0",
  "private": true,
  "description": "Backend foundation for Shiva, a private personal AI.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/database/migrate.js",
    "db:migrate:dev": "tsx src/database/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "dev:device-agent": "tsx watch src/agents/device/device-agent-runner.ts",
    "build": "tsc -p tsconfig.json && tsc-esm-fix --tsconfig=tsconfig.json --ext=.js",
    "start": "node dist/server.js",
    "start:device-agent": "node dist/agents/device/device-agent-runner.js",
    "test": "tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "google-auth-library": "^11.0.2",
    "pg": "^8.23.0",
    "undici": "^8.10.0",
    "ws": "^8.18.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
