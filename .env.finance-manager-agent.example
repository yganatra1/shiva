# Local development only. Production finance-manager-agent receives explicit PM2/Compose env.
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgresql://shiva:change-me@127.0.0.1:5432/shiva
DATABASE_POOL_MAX=5
DATABASE_SSL=false
SHIVA_BRAIN_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
SHIVA_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
OPENAI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
SHIVA_CONTEXT_LENGTH=16384
SHIVA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT_MS=300000
SHIVA_USER_ID=00000000-0000-4000-8000-000000000001
SHIVA_USER_NAME=Yash
SHIVA_TIME_ZONE=Asia/Kolkata
AGENT_MAX_STEPS=12
AGENT_REQUEST_TIMEOUT_MS=300000
AGENT_RECLAIM_IDLE_MS=30000
AGENT_MAX_DELIVERY_ATTEMPTS=3
AGENT_HEARTBEAT_TTL_SECONDS=15
FINANCE_MFAPI_BASE_URL=https://api.mfapi.in
FINANCE_MFAPI_TIMEOUT_MS=10000
FINANCE_MFAPI_MAX_RETRIES=2
FINANCE_MFAPI_MAX_CONCURRENCY=5
FINANCE_MFAPI_CACHE_TTL_SECONDS=21600
# Temporary Indian risk-free/MAR assumption until an external rate provider exists.
FINANCE_RISK_FREE_RATE=0.065
FINANCE_MANAGER_AGENT_HOST=127.0.0.1
FINANCE_MANAGER_AGENT_PORT=3004
