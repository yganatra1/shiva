# Local development only. Production developer-agent receives explicit PM2/Compose env.
#
# IMPORTANT: this process must run as the same Linux/macOS user that ran
# `claude login` on this host, or the claude CLI won't see the saved OAuth
# session and every developer_execute call will fail.
#
# DEVELOPER_AGENT_PERMISSION_MODE=bypassPermissions (full access, no
# containment) refuses to start when this process's effective user is root —
# it needs a genuinely non-root user. The default here, "acceptEdits", works
# under root: it auto-approves file read/write/edit and auto-denies anything
# else (git, tests, other shell commands) rather than prompting, since
# headless mode has no terminal to prompt on.
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379
SHIVA_BRAIN_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
SHIVA_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
OPENAI_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
SHIVA_CONTEXT_LENGTH=16384
SHIVA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT_MS=300000
SHIVA_USER_ID=00000000-0000-4000-8000-000000000001
SHIVA_USER_NAME=Yash
SHIVA_TIME_ZONE=Asia/Kolkata
AGENT_MAX_STEPS=12
# Claude Code sessions can legitimately run for many minutes; this codebase's
# env schema allows up to 86400000 (24h) for both this value and the root
# .env's AGENT_TASK_TIMEOUT_MS (Core's wait per delegated task) — keep the two
# in sync, since Core will otherwise give up on the agent before it finishes.
AGENT_REQUEST_TIMEOUT_MS=1800000
AGENT_RECLAIM_IDLE_MS=30000
AGENT_MAX_DELIVERY_ATTEMPTS=3
AGENT_HEARTBEAT_TTL_SECONDS=15
# name:path,name:path — the model may only select a configured name, never
# supply an arbitrary path. Point "shiva" at a throwaway clone before ever
# pointing it at the checkout Shiva itself is running from.
DEVELOPER_AGENT_REPOS=shiva:/workspace/shiva/repo
# Wall-clock cap this agent enforces itself (the claude CLI has none); keep
# below AGENT_REQUEST_TIMEOUT_MS to leave headroom for planner/executor overhead.
DEVELOPER_AGENT_EXECUTION_TIMEOUT_MS=1500000
DEVELOPER_AGENT_MAX_TURNS=60
DEVELOPER_AGENT_PERMISSION_MODE=acceptEdits
# Comma-separated Claude Code tool patterns pre-approved to actually run
# regardless of the permission mode above — without this, acceptEdits can
# change a file but never verify it, since headless mode has no terminal to
# approve a Bash call it wasn't told about in advance. Defaults to this
# repo's own npm/npx tooling (covers typecheck/build/test); extend for other
# stacks, but keep it scoped to validation, not git or destructive commands.
DEVELOPER_AGENT_ALLOWED_TOOLS=Bash(npm *),Bash(npx *)
